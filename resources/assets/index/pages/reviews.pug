                                        p Хочу выразить огромную благодарность врачу-эндокринологу амбулаторного отделения 2 ГДКБ Павлычевой Екатерине Святославовне! Сын состоит на учете с диагнозом субклинический гипотиреоз, АИТ?, задержка пубертата. Ведет нас другой доктор, но по причине ее отпуска попали на прием к Екатерине Святославовне. Очень деликатная, внимательная, тактичная. Мои сомнения и вопросы грамотно и спокойно аргументировала и разъясняла. Но самое главное - она нашла нужные слова, вселила в сына уверенность, что всё есть и будет хорошо (ведь понятно, какие страдания 14-летнему подростку доставляют мысли о том, что с его развитием что-то не так). Сын просто воспрял духом, поэтому я и пишу этот отзыв. Чтобы сказать, что врач - это не только профессионал, но и Человек! Екатерина Святославовна - врач на своем месте.

                        +paginator('sm')
                    .section.section_dark
                        .box
                            .section__caption.mb-big.text-center
                                h2.heading Оставить свой отзыв
                            form.form
                                .flex.flex_form
                                    .flex__cell
                                        .form__row
                                            label.form__label Название организации
                                            .form__control
                                                input.form__input(type="text")
                                        .form__row
                                            label.form__label Контактное лицо
                                            .form__control
                                                input.form__input(type="text")
                                        .form__row.form__required
                                            label.form__label Электронная почта (обязательно)
                                            .form__control
                                                input.form__input(type="email")
                                                .form__error-message Необходимо указать адрес электронной почты
                                        .form__row.form__required
                                            label.form__label Номер телефона (обязательно)
                                            .form__control
                                                input.form__input(type="tel")
                                                .form__error-message Необходимо ввести телефон
                                    .flex__cell
                                        .form__row
                                            label.form__label Текст отзыва
                                            .form__control
                                                textarea.form__textarea(rows="11")
                                        .form__row
                                            label.form__label Ваша оценка
                                            .form__control
                                                .rating-btn
                                                    .rating-btn__wrap
                                                        - var number = 5;
                                                        while number > 0
                                                            - var count = number--
                                                            input.rating-btn__input(id="rating-btn-" + count type="radio" name="rating" value=count)
                                                            label.rating-btn__label(for="rating-btn-" + count)
                                                                span.rating-btn__icon.icon.icon_star
                                                                    svg.icon__item
                                                                        use(xlink:href="#icon_star")

                                .cover
                                    .cover__side
                                        button(type="submit").btn.btn_type_bright Добавить отзыв

                .overlay
            +footer
        +search-popup
        script(src="../assets/index/js/main.js")
        +browser-update