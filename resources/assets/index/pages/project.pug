include ../blocks/includes/includes.pug

doctype html
html
    +head
    body
        +holder
        div.svg-box
            +svg-icons
        .wrapper
            .wrapper__inner
                +header
                main.container
                    .box
                        +breadcrumbs('Главная', 'Проекты')
                    article.article
                        .box
                            .top
                                h1.top__title.title СХП «Авангард» — миксера и насосы для лагун
                            .layout.layout_text.mb-large
                                .layout__side
                                    .layout__head.layout__head_underline
                                        h2.layout__subtitle Задача
                                .layout__base
                                    .content
                                        p
                                            | <strong>Процесс монтажа приобретенной заказчиком системы вентиляции не менее важен, чем процесс ее проектирования и изготовления. От качества монтажных работ напрямую зависит правильность функционирования всего комплекса оборудования.</strong>
                                        p Если контроль действий монтажников производится изготовителем системы, это позволяет «на ходу» корректировать работу и устранять некоторые возможные ошибки. Приведем несколько примеров проблем, с которыми может столкнуться персонал, монтирующий вентиляционную систему.
                            .layout.layout_text.mb-xlarge
                                .layout__side
                                    .layout__head.layout__head_underline
                                        h2.layout__subtitle Решение
                                .layout__base
                                    .content
                                        p Замеры помещения и толщины перекрытий, проведенные при разработке проекта, могут оказаться неточными — особенно часто это встречается при проектировании параллельно с ремонтом или строительством здания. В этом случае может понадобиться нарастить или укоротить воздуховоды, установить не предусмотренные проектом элементы — а это может повлечь необходимость изменения некоторых параметров работы оборудования.
                                        .slider.slider_simple.mb-mid
                                            .slider__box.slider__box_content
                                                - var number = 1;
                                                - var items = [ {title: 'Автоматическая линия сварки балок PME-group (Финляндия)'}, {title: 'Автоматическая линия сварки STE-group (Франция)'}, {title: 'Автоматическая линия сварки балок PME-group (Финляндия)'}, {title: 'Автоматическая линия сварки балок PME-group (Финляндия)'}, {title: 'Автоматическая линия сварки балок PME-group (Финляндия)'}, {title: 'Автоматическая линия сварки балок PME-group (Финляндия)'}, {title: 'Автоматическая линия сварки STE-group (Франция)', placeholder: 'placeholder'} ];
                                                each item in items
                                                    -var count = number
                                                    .slider__item
                                                        if item.placeholder
                                                            img.slider__img(src="../assets/index/images/markup/slider_sm_" + count + ".jpg" alt="")
                                                            //img.slider__img(src="holder.js/984x606?theme=topic&auto=true" alt="")
                                                        else
                                                            img.slider__img(src="../assets/index/images/markup/slider_sm_" + count + ".jpg" alt="")
                                                        .slider__title=item.title
                                            .slider__box.slider__box_nav
                                                - var numberTh = 1;
                                                each item in items
                                                    -var countTh = numberTh
                                                    .slider__thumb
                                                        if item.placeholder
                                                            //img.slider__img(src="holder.js/167x103?theme=topic&auto=true" alt="")
                                                            img.slider__img(src="../assets/index/images/markup/slider_sm_thumb_" + countTh + ".jpg" alt="")
                                                        else
                                                            img.slider__img(src="../assets/index/images/markup/slider_sm_thumb_" + countTh + ".jpg" alt="")

                                        p В этом случае может понадобиться нарастить или укоротить воздуховоды, установить не предусмотренные проектом элементы — а это может повлечь необходимость изменения некоторых параметров работы оборудования.
                                        p Представители корпорации обладают всеми необходимыми компетенциями для проведения профессионального контроля монтажа и пусконаладки вентиляционной системы любой сложности — будь то вентиляция небольшого кафе или масштабная система подачи и вывода воздуха огромного производственного цеха. Наши услуги сэкономят ваше время и средства предприятия!

                            .card.mb-large
                                .card__side
                                    .card__person
