        script(src="../assets/index/js/main.js")
        script.
            var tag = document.createElement('script');
            tag.src = "https://www.youtube.com/player_api";
            var firstScriptTag = document.getElementsByTagName('script')[0];
            firstScriptTag.parentNode.insertBefore(tag, firstScriptTag);

            var player;
            function onYouTubePlayerAPIReady() {
                player = new YT.Player('bg-video', {
                    height: '800',
                    width: '1280',
                    videoId: 'EZiRLYlnm28',
                    playerVars: {
                        'autoplay': 0,
                        'controls': 0,
                        'disablekb': 1,
                        'fs': 0,
                        'iv_load_policy': 3,
                        'modestbranding': 1,
                        'rel': 0,
                        'showinfo': 0
                    }
                });
            }
            function playVideo(e) {
                e.preventDefault();
                player.playVideo();

                var $panel = $('.panel');
                $panel.addClass('panel_play');
            }
            $(document).on('click', '.panel__play', playVideo);

