                                                    a.list__link(href="#") Скачать договор
                                                    span.list__mark (19 Mb, pdf)
                                                li.list__item
                                                    a.list__link(href="#") Скачать прайс-лист
                                                    span.list__mark (37 Mb, pdf)
                                            .row
                                                a.btn.btn_type_bright(href="#") Подобрать оборудование

                                        .docs__cell
                                            h3.subtitle Сертификаты и гарантия
                                            .flex.flex_sert
                                                .flex__cell
                                                    a.item(href="#")
                                                        .item__figure
                                                            img.item__img(src="../assets/index/images/markup/item_1.jpg" alt="")
                                                        .item__wrap
                                                            .item__desc
                                                                span.item__text Сертификат соответствия ГОСТ 20295-85
                                                .flex__cell
                                                    a.item(href="#")
                                                        .item__figure
                                                            img.item__img(src="../assets/index/images/markup/item_1.jpg" alt="")
                                                        .item__wrap
                                                            .item__desc
                                                                span.item__text Декларация о соответствии таможенного союза
                        .advantages.mb-xlarge
                            .advantages__box.box
                                .advantages__side
                                    h2.advantages__title Наши преимущества
                                .advantages__base
                                    .advantages__grid
                                        ul.advantages__list
                                            li.advantages__item Дробеструйная обработка металла
                                            li.advantages__item Раскрой листового металла на машинах газовой и плазменной резки
                                            li.advantages__item Изготовление электросварной балки
                                            li.advantages__item Раскрой проката
                                            li.advantages__item Изготовление комплектующих
