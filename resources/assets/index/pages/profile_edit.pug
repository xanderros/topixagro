include ../blocks/includes/includes.pug

doctype html
html
    +head
    body
        +holder
        div.svg-box
            +svg-icons
        .wrapper
            .wrapper__inner
                +header
                main.container
                    .box
                        +breadcrumbs('Личный кабинет')
                        .top
                            h1.top__title.title Редактирование профиля
                        .layout.layout_profile
                            .layout__side
                                .submenu.submenu_side.js-sub
                                    .submenu__default
                                        a.submenu__all.js-sub__btn(href="#") Профиль
                                    ul.submenu__list.js-sub__content
                                        li.submenu__item.submenu__item_active
                                            a.submenu__link(href="#")
                                                .submenu__icon
                                                    span.icon.icon_profile
                                                        svg.icon__item
                                                            use(xlink:href="#icon_profile")
                                                span.submenu__text Профиль
                                        li.submenu__item
                                            a.submenu__link(href="#")
                                                .submenu__icon
                                                    span.icon.icon_orders
                                                        svg.icon__item
                                                            use(xlink:href="#icon_orders")
                                                span.submenu__text Заказы
                                        li.submenu__item.submenu__item_last
                                            a.submenu__link(href="#")
                                                .submenu__icon
                                                    span.icon.icon_exit
                                                        svg.icon__item
                                                            use(xlink:href="#icon_exit")
                                                span.submenu__text Выход
                                .aside.aside_desktop
                                    a.aside__link(href="#")
                                        img.aside__img(src="../assets/index/images/markup/aside_1.jpg" alt="")
                            .layout__base
                                .bordered.mb-large
                                    form.bordered__form.form
                                        .form__row
                                            label.form__label УСН
                                            .form__control
                                                input.form__input(type="text")
                                                .form__error-message Данный УСН не существует
                                        .form__row
                                            label.form__label Название организации
                                            .form__control
                                                input.form__input(type="text")
                                        .form__row
                                            label.form__label ФИО
                                            .form__control
                                                input.form__input(type="text")
                                                .hint
                                                    .hint__container Данный человек будет являться администратором личного кабинета
                                        .form__row
                                            label.form__label Должность
                                            .form__control
                                                input.form__input(type="text")
                                                .hint
                                                    .hint__container Например, директор
                                        .form__row
                                            label.form__label Мобильный телефон
                                            .form__control
                                                input.form__input(type="tel")
                                                .hint
                                                    .hint__container Этот телефон понадобится для входа в личный кабинет и на него будет отправлена SMS с кодом активации
                                        .form__row
                                            label.form__label Реквизиты
                                            .form__control
                                                .attach
                                                    .attach__item
                                                        a.attach__del(href="#")
                                                            span.attach__icon.icon.icon_close
                                                                svg.icon__item
                                                                    use(xlink:href="#icon_close")
                                                        a.attach__link.link-dark(href="#")
                                                            span.link-dark__text Реквизиты.docx
                                                    .attach__item
                                                        a.attach__del(href="#")
                                                            span.attach__icon.icon.icon_close
                                                                svg.icon__item
                                                                    use(xlink:href="#icon_close")
                                                        a.attach__link.link-dark(href="#")
                                                            span.link-dark__text Реквизиты.docx
                                                .file.file_small
                                                    .file__container
                                                        .file__upload
                                                            input.file__input(type="file")
                                                            .file__select
                                                                span.file__clip-icon.icon.icon_clip
                                                                    svg.icon__item
                                                                        use(xlink:href="#icon_clip")
                                                                .file__link Прикрепить файл
                                                    .file__info
                                                        .form__error-message Недопустимый формат файла
                                                        .file__notice до 10 Мб, допустимый формат doc, docx, rtf, pdf, xls
                                                    .file__loader
                                                        span.loader.loader_file
                                                    .hint
                                                        .hint__container Файл с полным юридическим и физическим адресом, банковские реквизиты.
                                        .form__btn
                                            button(type="submit").btn.btn_type_bright Редактировать

                                .subtitle Персональный менеджер компании и контакты
                                .grid.grid_cards.mb-xlarge
                                    .grid__cell
                                        .wall.wall_light
                                            .card.card_simple
                                                figure.card__figure
                                                    img.card__img(src="../assets/index/images/markup/card_1.jpg" alt="")
                                                    //img.card__img(src="holder.js/100x100?theme=topic&auto=true" alt="")
                                                .card__box
                                                    .card__title Константин Забнин
                                                    .card__info Менеджер по направлению
                                                    .wall__row.wall__row_mid
                                                        a.wall__tel(href="tel:+375175102390") +37517 510-23-90
                                                    .wall__row.wall__row_mid
                                                        a.wall__link.link-dark(href="mailto:cc@topixagro.com")
                                                            span.link-dark__text cc@topixagro.com
                                                    .wall__line
                                                        a.btn.btn_type_bright.btn_size_wide(href="#") Написать
                                                    .wall__line
                                                        a.wall__link.link-dark(href="skype:topixagro?chat")
                                                            span.link-dark__text Написать в скайп
                                    .grid__cell
                                        .wall.wall_light.wall_mid
                                            .wall__info
                                                .wall__caption Консультация по доставке
                                                .wall__row
                                                    a.wall__tel(href="tel:+375175102390") +37517 510-23-90
                                            .wall__info
                                                .wall__caption Возврат товара
                                                .wall__row
                                                    a.wall__tel(href="tel:+375175102390") +37517 510-23-90
                                            .wall__info
                                                .wall__caption Техническая поддержка
                                                .wall__row
                                                    a.wall__tel(href="tel:+375175102390") +37517 510-23-90
                                            .wall__info
                                                .wall__caption Бухгалтерия
                                                .wall__row
                                                    a.wall__tel(href="tel:+375175102390") +37517 510-23-90
                                            .wall__info
                                                .wall__caption Юридический отдел
                                                .wall__row
                                                    a.wall__tel(href="tel:+375175102390") +37517 510-23-90


                .overlay
            +footer
        +search-popup
        script(src="../assets/index/js/main.js")
        +browser-update