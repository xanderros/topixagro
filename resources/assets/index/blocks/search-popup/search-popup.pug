mixin search-popup
    .search.search_popup
        .search__box.box
            form.search__body.form
                .search__header
                    .search__field
                        input.form__input.form__input_search(type="text" placeholder="Что найти?")
                    a.js-search__close.search__close(href="#")
                        span.search__icon.icon.icon_close
                            svg.icon__item
                                use(xlink:href="#icon_close")
                .search__layout
                    .search__content
                        .search__none Ничего не найдено
                        ul.search__category
                            li.search__item
                                a.search__link(href="#") Электроды
                            li.search__item
                                a.search__link(href="#") Электровеники
                            li.search__item
                                a.search__link(href="#") Электрогрили
                            li.search__item
                                a.search__link(href="#") Эпиляторы и женские электробритвы
                            li.search__item
                                a.search__link(href="#") Электрорубанки
                        .search__products
